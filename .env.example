# Copy this file to .env and paste your real keys next to each name.
# .env is git-ignored, so your keys stay on your Mac only.
# Never type your keys into a prompt file or a YAML file.

# --- Required: the LLM that tags and analyses everything ---
# Free, no credit card: https://aistudio.google.com/apikey  -> "Create API key"
GEMINI_API_KEY=

# --- Fallback LLM, used only if Gemini fails ---
# Free, no credit card: https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=

# --- Optional: YouTube comments source (Milestone 1) ---
# Free, no credit card: https://console.cloud.google.com
#   1. Create a project
#   2. APIs & Services -> Library -> search "YouTube Data API v3" -> Enable
#   3. Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=