# Secrets — never commit
.env
# Hand-copied posts (Quora, X, Instagram, blogs) stay on this machine.
# The template is the one exception: it holds only fake example rows, and shipping it
# means a fresh clone can start filling it in immediately.
data/manual/*.csv
!data/manual/TEMPLATE_manual_posts.csv

# Raw API responses (traceability only, can be large)
data/raw/

# SQLite database (pipeline state)
data/engine.db
data/engine.db-journal
data/engine.db-wal
data/engine.db-shm

# LLM disk cache lives inside the SQLite db, nothing extra to ignore

# Local collector caches (YouTube search results are 100 quota units each, so they
# are worth keeping on this machine but must never be committed)
data/cache/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/